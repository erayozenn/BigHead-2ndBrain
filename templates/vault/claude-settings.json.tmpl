{
  "permissions": {
    "deny": [
      "Read(./.obsidian/**)",
      "Edit(./.obsidian/**)",
      "Read(./**/.env*)",
      "Edit(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*secret*)",
      "Bash(mv:*)",
      "Bash(rm:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "PowerShell(Move-Item:*)",
      "PowerShell(Rename-Item:*)",
      "PowerShell(Remove-Item:*)"
    ],
    "ask": [
      "Edit(./raw/**)",
      "Edit(./projects/**)",
      "Edit(./playbooks/**)"
    ]
  }
}
